#!/bin/sh
# Garde generation-cours.zip synchronisé avec SKILL.md / examples/.
#
# Ce hook n'est PAS actif automatiquement après un git clone (git ne suit pas
# .git/hooks/). Activer une fois par clone avec :
#   git config core.hooksPath .githooks

set -e

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

sources="SKILL.md examples/README.md examples/exemple-cryptographie-post-quantique.md"

staged=$(git diff --cached --name-only --diff-filter=ACMR)

needs_rebuild=0
for f in $sources; do
    if printf '%s\n' "$staged" | grep -qx "$f"; then
        needs_rebuild=1
        break
    fi
done

if [ "$needs_rebuild" -eq 0 ]; then
    exit 0
fi

echo "pre-commit: régénération de generation-cours.zip..."

if command -v zip >/dev/null 2>&1; then
    rm -f generation-cours.zip
    zip -q -X generation-cours.zip $sources
elif command -v powershell.exe >/dev/null 2>&1; then
    powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$repo_root/.githooks/build-zip.ps1"
elif command -v pwsh >/dev/null 2>&1; then
    pwsh -NoProfile -ExecutionPolicy Bypass -File "$repo_root/.githooks/build-zip.ps1"
else
    echo "pre-commit: ni 'zip' ni PowerShell trouvés — impossible de régénérer generation-cours.zip." >&2
    echo "Régénère-le manuellement (voir README.md) puis relance le commit." >&2
    exit 1
fi

git add generation-cours.zip
echo "pre-commit: generation-cours.zip mis à jour et ajouté au commit."
