#!/bin/sh
# Garde analyse-locative.zip synchronisé avec SKILL.md / references/ / examples/.
#
# Ce hook n'est PAS actif automatiquement après un git clone (git ne suit pas
# .git/hooks/). Activer une fois par clone avec :
#   git config core.hooksPath .githooks

set -e

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

sources="SKILL.md references/calculs.md examples/README.md examples/en-tetes.tsv examples/sortie-t2-ancien.tsv examples/sortie-t3-neuf.tsv examples/t2-ancien-saint-etienne.md examples/t3-neuf-angers.md"

staged=$(git diff --cached --name-only --diff-filter=ACMR)

needs_rebuild=0
for f in $sources; do
    if printf '%s\n' "$staged" | grep -qx "$f"; then
        needs_rebuild=1
        break
    fi
done

if [ "$needs_rebuild" -eq 0 ]; then
    exit 0
fi

echo "pre-commit: régénération de analyse-locative.zip..."

if command -v zip >/dev/null 2>&1; then
    rm -f analyse-locative.zip
    zip -q -X analyse-locative.zip $sources
elif command -v powershell.exe >/dev/null 2>&1; then
    powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$repo_root/.githooks/build-zip.ps1"
elif command -v pwsh >/dev/null 2>&1; then
    pwsh -NoProfile -ExecutionPolicy Bypass -File "$repo_root/.githooks/build-zip.ps1"
else
    echo "pre-commit: ni 'zip' ni PowerShell trouvés — impossible de régénérer analyse-locative.zip." >&2
    echo "Régénère-le manuellement (voir README.md) puis relance le commit." >&2
    exit 1
fi

git add analyse-locative.zip
echo "pre-commit: analyse-locative.zip mis à jour et ajouté au commit."
